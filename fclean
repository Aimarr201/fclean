#!/usr/bin/env bash
# fclean para las sesiones de usuario de Ubuntu del campus 42.
# fclean: actualizaciones v1
# Con source, la Zsh que inició la instalación recarga su configuración al terminar.
if [ -n "${ZSH_VERSION:-}" ] && [ -z "${BASH_VERSION:-}" ]; then
    if [[ $ZSH_EVAL_CONTEXT == *:file ]]; then
        if [[ $# != 1 || ( $1 != --alias && $1 != --install ) ]]; then
            printf '%s\n' 'Usa source ./fclean --install o source ./fclean --alias para configurar esta sesión.' >&2
            return 2
        fi
        FCLEAN_RELOAD_ZSH=1 /bin/bash -- "${(%):-%x}" "$1" || return $?
        # El directorio actual puede haber sido el clon recién retirado.
        if [[ ! -d $PWD ]]; then builtin cd -q -- "$HOME" || return $?; fi
        set --
        builtin source "${ZDOTDIR:-$HOME}/.zshrc"
        return $?
    fi
    exec /bin/bash -- "$0" "$@"
fi
set -euo pipefail
umask 077
shopt -s nullglob

usage() {
    cat <<'HELP'
Uso: fclean [opción] o bash fclean [opción]

  --dry-run        Muestra qué se limpiaría y qué puede migrarse.
  --clean          Comprueba actualizaciones y limpia. Venvs tras 5 días de inactividad.
  --fclean         Misma limpieza con borrado inmediato de venvs reconocidos.
  --migrate        Traslada las extensiones de VS Code a sgoinfre.
  --migrate-cache  Traslada ~/.cache a sgoinfre.
  --alias          Instala el script y el alias de Zsh, y retira la descarga original.
  --install        Configura el alias en Zsh y la limpieza al iniciar sesión.
  --uninstall      Retira el inicio automático y la configuración de sgoinfre; conserva el alias.
  --funinstall     Retira toda la instalación, incluido el script y el seguimiento de venvs.
  -h, --help       Muestra esta ayuda, también disponible sin opciones.

La limpieza borra datos sin confirmación. Cierra las aplicaciones antes de migrar.
HELP
}

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
notice() { printf '%s\n' "$*" >&2; }
present() { [[ -e $1 || -L $1 ]]; }

(( $# <= 1 )) || { usage >&2; exit 2; }
mode=${1:---help}
case $mode in
    --help|-h) usage; exit 0 ;;
    --dry-run|--clean|--fclean|--migrate|--migrate-cache|--alias|--install|--uninstall|--funinstall|--prepare-env) ;;
    *) usage >&2; exit 2 ;;
esac

[[ $(uname -s) == Linux && $EUID != 0 ]] || die 'Ejecuta fclean como usuario del campus en Ubuntu.'
[[ ${HOME:-} == /* && -d $HOME ]] || die 'HOME debe ser un directorio absoluto.'
home=$(realpath -e -- "$HOME")
[[ $home != / ]] || die 'HOME apunta a la raíz.'
account=$(id -un)
[[ ${USER:-} == "$account" && -n $account && $account != */* && $account != . && $account != .. ]] ||
    die 'USER debe coincidir con el nombre de la cuenta de la sesión.'
sgo="$HOME/sgoinfre/$USER"
config=${XDG_CONFIG_HOME:-$HOME/.config}
[[ $config == /* ]] || die 'XDG_CONFIG_HOME debe ser absoluto.'
installed="$config/fclean/fclean"
desktop="$config/autostart/42-fclean.desktop"
marker='# Gestionado por 42-fclean'
zshrc="${ZDOTDIR:-$HOME}/.zshrc"
begin='# >>> 42-SGOINFRE-SHIELD >>>'
end='# <<< 42-SGOINFRE-SHIELD <<<'
env_begin='# >>> fclean: entorno sgoinfre >>>'
env_end='# <<< fclean: entorno sgoinfre <<<'
alias_begin='# >>> fclean: alias >>>'
alias_end='# <<< fclean: alias <<<'

# El bloqueo local también funciona cuando la cuota del home está agotada.
resumed_clean=false
if [[ $mode != --dry-run && $mode != --prepare-env ]]; then
    runtime=${XDG_RUNTIME_DIR:-/run/user/$UID}
    [[ -d $runtime && -O $runtime && ! -L $runtime ]] || die 'No se encuentra el directorio de ejecución de la sesión.'
    lock="$runtime/42-fclean.lock"
    if [[ $mode == --clean && ${FCLEAN_UPDATED_PID:-} == "$$" && /proc/self/fd/9 -ef "$lock" ]]; then
        resumed_clean=true
    else
        exec 9>>"$lock"
    fi
    flock -n 9 || die 'Ya hay otra ejecución de fclean o no se pudo tomar el bloqueo.'
fi
unset FCLEAN_UPDATED_PID

clean_update_target() {
    local source=$1 dir=${1%/*} checksum target initial
    if [[ $source -ef $installed && ! -L $installed && -O $installed ]]; then
        printf '%s\n' "$installed"
        return
    fi
    # Conserva el script original al ejecutar desde una copia de trabajo.
    if command -v git >/dev/null && git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        if ! git -C "$dir" ls-files --error-unmatch -- "${source##*/}" >/dev/null 2>&1 ||
           ! git -C "$dir" diff --quiet --no-ext-diff HEAD -- "${source##*/}"; then
            return 1
        fi
    fi
    checksum=$(sha256sum < "$source") || return 1
    target="$runtime/fclean-${checksum%% *}"
    if ! present "$target"; then
        initial=$(mktemp -- "$runtime/.fclean-initial.XXXXXXXX") || return 1
        if ! cp -- "$source" "$initial" || ! mv -T -- "$initial" "$target"; then
            rm -f -- "$initial"
            return 1
        fi
    fi
    printf '%s\n' "$target"
}

valid_update() {
    [[ -f $1 && -O $1 && ! -L $1 ]] &&
        grep -Fxq -- '# fclean para las sesiones de usuario de Ubuntu del campus 42.' "$1" &&
        grep -Fxq -- '# fclean: actualizaciones v1' "$1" &&
        BASH_ENV= /bin/bash -n -- "$1"
}

update_clean_copy() (
    local target=$1 lock_file=$1.update.lock state=$1.etag stage response digest saved_digest etag lock_fd changed=false
    local upstream='https://raw.githubusercontent.com/Aimarr201/fclean/main/fclean'
    local -a conditional=()
    # 0 indica una copia nueva, 1 indica que puede usarse la copia actual.
    [[ -f $target && -O $target && ! -L $target ]] || exit 2
    if present "$lock_file" && [[ ! -f $lock_file || ! -O $lock_file || -L $lock_file ]]; then exit 2; fi
    exec {lock_fd}>>"$lock_file" || exit 2
    flock -n "$lock_fd" || exit 1
    stage=$(mktemp -d -- "${target%/*}/.fclean-update.XXXXXXXX") || exit 2
    trap 'rm -f -- "$stage/script" "$stage/request" "$stage/etag" "$stage/state"; rmdir -- "$stage"' EXIT
    digest=$(sha256sum < "$target") || exit 2
    if [[ -f $state && -O $state && ! -L $state ]] &&
       { IFS= read -r saved_digest && IFS= read -r etag; } < "$state" &&
       [[ ${digest%% *} == "$saved_digest" && -n $etag ]]; then
        printf '%s\n' "$etag" > "$stage/request" || exit 2
        conditional=(--etag-compare "$stage/request")
    fi
    response=$(curl -q --silent --show-error --fail --proto '=https' --connect-timeout 3 --max-time 6 \
        "${conditional[@]}" --etag-save "$stage/etag" --output "$stage/script" \
        --write-out '%{http_code}' "$upstream") || exit 2
    [[ $response != 304 ]] || exit 1
    [[ $response == 200 ]] && valid_update "$stage/script" || exit 2
    if ! cmp -s -- "$target" "$stage/script"; then
        chmod --reference="$target" -- "$stage/script" && mv -T -- "$stage/script" "$target" || exit 2
        changed=true
    fi
    if [[ -s $stage/etag ]] && IFS= read -r etag < "$stage/etag" && [[ -n $etag ]] &&
       digest=$(sha256sum < "$target") && printf '%s\n%s\n' "${digest%% *}" "$etag" > "$stage/state"; then
        mv -T -- "$stage/state" "$state" || notice 'No se pudo guardar el ETag de fclean.'
    fi
    $changed
)

if [[ $mode == --clean ]] && ! $resumed_clean; then
    if ! command -v curl >/dev/null; then
        notice 'curl no está disponible. Se continúa la limpieza con la copia actual.'
    elif source_script=$(realpath -e -- "${BASH_SOURCE[0]}") && update_target=$(clean_update_target "$source_script"); then
        updated=false
        if update_clean_copy "$update_target"; then
            updated=true
            notice 'fclean actualizado desde main.'
        elif [[ $? == 2 ]]; then
            notice 'No se pudo actualizar fclean. Se continúa con la copia disponible.'
        fi
        if $updated || { [[ $update_target != "$source_script" ]] &&
                         ! cmp -s -- "$source_script" "$update_target" && valid_update "$update_target"; }; then
            FCLEAN_UPDATED_PID="$$" exec /bin/bash -- "$update_target" --clean
        fi
    fi
fi

has_legacy_block() {
    [[ -f $1 ]] || return 1
    grep -Fxq -e "$begin" -e "$end" -- "$1" || { [[ $? == 1 ]] && return 1; die "No se pudo leer $1"; }
}

write_zsh_alias() {
    local command
    printf -v command '() { FCLEAN_RELOAD_ZSH=1 /bin/bash %q "$@" || return $?; ' "$1"
    command+='if [[ $# == 1 && $1 == --alias ]]; then set --; builtin source "${ZDOTDIR:-$HOME}/.zshrc"; fi; }'
    printf 'alias fclean=%q\n' "$command"
}

write_zsh_block() {
    local installed_command
    printf -v installed_command '/bin/bash %q' "$installed"
    if [[ $1 == alias ]]; then
        printf '%s\n' "$alias_begin"
        write_zsh_alias "$installed"
        printf '%s\n' "$alias_end"
        return
    fi
    printf '%s\n' "$env_begin"
    printf 'if %s --prepare-env; then\n' "$installed_command"
    cat <<'ZSH'
    SGO="$HOME/sgoinfre/$USER"
    export XDG_CACHE_HOME="$SGO/.cache"
    export XDG_DATA_HOME="$SGO/.local/share"
    export UV_CACHE_DIR="$SGO/.cache/uv"
    export HF_HOME="$SGO/.cache/huggingface"
else
    # Una subshell puede heredar estas rutas aunque se haya desmontado sgoinfre.
    if [[ ${XDG_CACHE_HOME:-} == "$HOME/sgoinfre/${USER:-}/.cache" ]]; then unset XDG_CACHE_HOME; fi
    if [[ ${XDG_DATA_HOME:-} == "$HOME/sgoinfre/${USER:-}/.local/share" ]]; then unset XDG_DATA_HOME; fi
    if [[ ${UV_CACHE_DIR:-} == "$HOME/sgoinfre/${USER:-}/.cache/uv" ]]; then unset UV_CACHE_DIR; fi
    if [[ ${HF_HOME:-} == "$HOME/sgoinfre/${USER:-}/.cache/huggingface" ]]; then unset HF_HOME; fi
    if [[ ${SGO:-} == "$HOME/sgoinfre/${USER:-}" ]]; then unset SGO; fi
fi
ZSH
    write_zsh_alias "$installed"
    printf '%s\n' "$env_end"
}

rotate_zsh_backups() {
    local new=$1 keep=$1 latest='' file meta LC_ALL=C
    shift
    if [[ -z $new ]] && (( $# < 2 )); then return 0; fi
    local -a copies=()
    for file in "$@"; do
        [[ ${file##*.} =~ ^[A-Za-z0-9]{8}$ && ! -L $file && -f $file && -O $file ]] || continue
        if ! meta=$(TZ=UTC0 LC_ALL=C stat -c '%h %z' -- "$file"); then
            if present "$file"; then return 1; fi
            continue
        fi
        [[ ${meta%% *} == 1 ]] || continue
        copies+=("$file")
        # cp -p conserva el mtime del original. El ctime permite ordenar las copias antiguas.
        if [[ -z $new && ${meta#* } > $latest ]]; then
            latest=${meta#* }
            keep=$file
        fi
    done
    for file in "${copies[@]}"; do
        if [[ $file != "$keep" ]] && present "$file"; then
            if ! find -P "$file" -maxdepth 0 -type f -uid "$UID" -links 1 -delete && present "$file"; then return 1; fi
        fi
    done
}

update_zshrc() (
    local action=$1 file=$2 input=/dev/null tmp snapshot='' backup='' block='' alias_line
    [[ $file == /* ]] || die 'ZDOTDIR debe ser una ruta absoluta.'
    if [[ ( $action == uninstall || $action == funinstall ) && ! -e $file ]]; then return 0; fi
    if present "$file"; then
        [[ -f $file ]] || die "Ruta de configuración inesperada: $file"
        file=$(realpath -e -- "$file")
        input=$file
        if [[ $action == uninstall ]] && ! grep -Fxq -e "$env_begin" -e "$env_end" \
            -e "$alias_begin" -e "$alias_end" -- "$file"; then return 0; fi
        if [[ $action == funinstall ]] && ! grep -Fxq -e "$env_begin" -e "$env_end" \
            -e "$alias_begin" -e "$alias_end" -e "$begin" -e "$end" -- "$file"; then return 0; fi
    else
        mkdir -p -- "${file%/*}"
    fi
    # Solo rota las copias presentes al empezar, también si otro puesto escribe en el mismo home.
    local -a previous=("${file}.antes-de-fclean."????????)
    tmp=$(mktemp -- "${file}.fclean.XXXXXXXX")
    trap 'rm -f -- "$tmp"; if [[ -n $snapshot ]]; then rm -f -- "$snapshot"; fi' EXIT
    if [[ $action == install || $action == alias ]]; then block=$(write_zsh_block "$action"); fi
    alias_line=$(write_zsh_alias "$installed")
    FCLEAN_ZSH_BLOCK="$block" FCLEAN_ZSH_ALIAS="$alias_line" awk -v action="$action" -v old="$begin" -v oldEnd="$end" \
        -v new="$env_begin" -v newEnd="$env_end" -v aliasBegin="$alias_begin" -v aliasEnd="$alias_end" '
            $0 == new || $0 == aliasBegin || (action != "uninstall" && $0 == old) {
                if (inside || seen[$0]++) exit 2
                inside = ($0 == new ? newEnd : ($0 == aliasBegin ? aliasEnd : oldEnd))
                if (action == "alias" && inside != aliasEnd) print
                else if ((action == "install" || action == "alias") && !written++) print ENVIRON["FCLEAN_ZSH_BLOCK"]
                next
            }
            $0 == newEnd || $0 == aliasEnd || (action != "uninstall" && $0 == oldEnd) {
                if (inside != $0) exit 2
                if (action == "alias" && inside != aliasEnd) print
                inside = ""
                next
            }
            inside && action == "alias" && inside != aliasEnd {
                if ($0 ~ /^alias fclean=/) {
                    if (!written++) print ENVIRON["FCLEAN_ZSH_ALIAS"]
                } else print
                next
            }
            inside && action == "uninstall" && /^alias fclean=/ {
                if (!written++) {
                    print aliasBegin
                    print
                    print aliasEnd
                }
                next
            }
            !inside { print }
            END {
                if (inside) exit 2
                if ((action == "install" || action == "alias") && !written) print ENVIRON["FCLEAN_ZSH_BLOCK"]
            }
        ' "$input" > "$tmp" || die "Marcadores incompletos o repetidos en $file"
    if [[ -f $file ]]; then
        if cmp -s -- "$file" "$tmp"; then
            if [[ $action != funinstall ]]; then rotate_zsh_backups '' "${previous[@]}"; fi
            return 0
        fi
        chmod --reference="$file" -- "$tmp"
        if [[ $action != funinstall ]]; then
            snapshot=$(mktemp -- "${file}.fclean.XXXXXXXX")
            cp -p -- "$file" "$snapshot"
            backup="${file}.antes-de-fclean.${snapshot##*.}"
            mv -nT -- "$snapshot" "$backup"
            ! present "$snapshot" || die "Ya existe la copia $backup"
            snapshot=''
        fi
    fi
    if ! mv -T -- "$tmp" "$file"; then
        if [[ -n $backup ]]; then rm -f -- "$backup"; fi
        die "No se pudo guardar la configuración de Zsh en $file"
    fi
    if [[ -n $backup ]]; then
        printf 'Copia de la configuración: %s\n' "$backup"
        rotate_zsh_backups "$backup" "${previous[@]}"
    fi
    printf 'Configuración de Zsh actualizada en %s\n' "$file"
)

# Protege también montajes bind, que pueden tener el mismo número de dispositivo.
mounts=()
while read -r _ _ _ _ target _; do
    printf -v target '%b' "$target"
    mounts+=("$target")
done < /proc/self/mountinfo

disposable_fclean_clone() (
    local root=$1 url branch ref history changes path resolved
    [[ -d $root/.git && ! -L $root/.git && -O $root && -O $root/.git ]] || return 1
    for path in "$home" "$installed" "$zshrc" "$runtime"; do
        resolved=$(realpath -m -- "$path") || return 1
        [[ $path != "$root" && $path != "$root/"* && $resolved != "$root" && $resolved != "$root/"* ]] || return 1
    done
    for path in "${mounts[@]}"; do
        [[ $path != "$root" && $path != "$root/"* ]] || return 1
    done
    # Las consultas deben describir este clon, incluso si se invocó fclean desde otro repositorio.
    for path in "${!GIT_@}"; do unset "$path"; done
    cd -P -- "$root" || return 1
    [[ $(git remote) == origin ]] || return 1
    url=$(git config --local --get-all remote.origin.url) || return 1
    case ${url%/} in
        https://github.com/*) path=${url#https://github.com/} ;;
        ssh://git@github.com/*) path=${url#ssh://git@github.com/} ;;
        git@github.com:*) path=${url#git@github.com:} ;;
        *) return 1 ;;
    esac
    path=${path%/}
    [[ ${path,,} == aimarr201/fclean || ${path,,} == aimarr201/fclean.git ]] || return 1
    branch=$(git symbolic-ref --quiet --short HEAD) || return 1
    [[ $(git for-each-ref --format='%(refname:short)' refs/heads) == "$branch" ]] || return 1
    ref=$(git rev-parse --verify "refs/remotes/origin/$branch") || return 1
    [[ $(git rev-parse HEAD) == "$ref" ]] || return 1
    # Git puede omitir el usuario SSH de la URL que registra en el reflog.
    history=$(git reflog show --format='%H %gs' HEAD) || return 1
    [[ $history == "$ref clone: from $url" || $history == "$ref clone: from ${url/git@github.com/github.com}" ]] || return 1
    # Un clon recién creado no contiene árboles de trabajo adicionales, operaciones pendientes ni archivos personales en .git.
    shopt -s dotglob
    for path in .git/*; do
        case ${path##*/} in
            HEAD|branches|config|description|hooks|index|info|logs|objects|packed-refs|refs|shallow) ;;
            *) return 1 ;;
        esac
    done
    changes=$(git for-each-ref --format='%(refname)') || return 1
    while IFS= read -r path; do
        case $path in
            "refs/heads/$branch"|refs/remotes/origin/*|refs/tags/*) ;;
            *) return 1 ;;
        esac
    done <<< "$changes"
    # Las etiquetas de un clon nuevo están empaquetadas. Una etiqueta local también cuenta como trabajo propio.
    for path in .git/refs/tags/* .git/hooks/* .git/info/*; do
        [[ $path == .git/hooks/*.sample || $path == .git/info/exclude ]] || return 1
    done
    git ls-files --error-unmatch -- fclean >/dev/null || return 1
    changes=$(git -c core.fsmonitor=false -c core.fileMode=true status --porcelain --untracked-files=all --ignored --ignore-submodules=none) || return 1
    [[ -z $changes ]] || return 1
    changes=$(git ls-files -v) || return 1
    while IFS= read -r path; do [[ $path == 'H '* ]] || return 1; done <<< "$changes"
)

install_alias() (
    local entry=${BASH_SOURCE[0]} dir=${installed%/*} source parent path tmp='' identity retiring
    parent=$(cd -P -- "$(dirname -- "$entry")" && pwd -P)
    source=$parent/${entry##*/}
    identity=$(stat -c '%d:%i:%z' -- "$source")
    [[ ! -L $dir ]] || die "La carpeta de instalación es un enlace: $dir"
    mkdir -p -- "$dir"
    if ! present "$installed"; then
        tmp=$(mktemp -- "$dir/.instalacion.XXXXXXXX")
        trap 'rm -f -- "$tmp"' EXIT
        cp -- "$source" "$tmp"
        valid_update "$tmp" || die 'La copia del script no es válida.'
        mv -nT -- "$tmp" "$installed"
    fi
    valid_update "$installed" || die "El destino no es una copia válida de fclean: $installed"
    update_zshrc alias "$zshrc"
    printf 'Alias fclean configurado para %s.\n' "$installed"
    if [[ ${FCLEAN_RELOAD_ZSH:-} != 1 ]]; then
        printf 'Para activarlo en la Zsh actual, ejecuta: source %q\n' "$zshrc"
    fi
    [[ $source != "$(realpath -e -- "$installed")" ]] || return 0
    if [[ ! -O $source || $(stat -c '%d:%i:%z' -- "$source") != "$identity" ]] || ! cmp -s -- "$source" "$installed"; then
        notice "Se conserva el origen porque tiene otro propietario o su contenido difiere de la copia instalada: $source"
        return 0
    fi
    # Busca también .git sin Git disponible: un fallo de detección no convierte un proyecto en una descarga suelta.
    path=$parent
    while [[ ! -f $path/.git && ! -L $path/.git && ! -e $path/.git/HEAD &&
             ! ( -d $path/.git && ! -x $path/.git ) &&
             ! ( -d $path/objects && -d $path/refs && -f $path/HEAD ) ]]; do
        if [[ $path == / ]]; then
            if [[ $(stat -c '%d:%i:%z' -- "$source") != "$identity" ]]; then
                notice "El archivo de origen cambió durante la instalación: $source"
                return 0
            fi
            rm -f -- "$source"
            printf 'Archivo de descarga retirado: %s\n' "$source"
            return 0
        fi
        path=$(dirname -- "$path")
    done
    if [[ $source == "$path/fclean" && ! -L $source ]] && disposable_fclean_clone "$path"; then
        # Revalida en una carpeta privada. Otra descarga puede ocupar el nombre original mientras tanto.
        retiring=$(mktemp -d -- "${path%/*}/.fclean-clon.XXXXXXXX")
        if ! mv -T -- "$path" "$retiring/clon"; then
            rmdir -- "$retiring"
            die "No se pudo retirar el clon: $path"
        fi
        if disposable_fclean_clone "$retiring/clon" && cmp -s -- "$retiring/clon/fclean" "$installed"; then
            rm -rf --one-file-system -- "$retiring/clon"
            printf 'Clon de fclean retirado: %s\n' "$path"
        else
            mv -nT -- "$retiring/clon" "$path" && [[ ! -d $retiring/clon ]] ||
                die "El clon cambió. Sus archivos están en $retiring/clon"
            notice "Se conserva el clon porque cambió durante la instalación: $path"
        fi
        rmdir -- "$retiring"
    else
        notice "Se conserva el repositorio de origen: $path"
    fi
)

install_autostart() (
    local dir=${installed%/*} tmp entry path
    if present "$desktop"; then
        [[ -f $desktop && ! -L $desktop ]] && grep -Fxq -- "$marker" "$desktop" ||
            die "Ya existe una entrada ajena en $desktop"
    fi
    # Path fija el directorio de trabajo para el inicio automático.
    path=${dir//\\/\\\\}
    path=${path//$'\t'/\\t}
    [[ $path != *[[:cntrl:]]* ]] || die 'Ruta de configuración incompatible con el inicio automático.'
    mkdir -p -- "$dir" "${desktop%/*}"
    if present "$installed"; then
        [[ -f $installed && ! -L $installed ]] && grep -Fxq -- '# fclean para las sesiones de usuario de Ubuntu del campus 42.' "$installed" ||
            die "Ya existe otro archivo en $installed"
    fi
    tmp=$(mktemp -- "$dir/.instalacion.XXXXXXXX")
    trap 'rm -f -- "$tmp"' EXIT
    entry=$(mktemp -- "${desktop%/*}/.42-fclean.XXXXXXXX")
    trap 'rm -f -- "$tmp" "$entry"' EXIT
    cp -- "${BASH_SOURCE[0]}" "$tmp"
    printf '[Desktop Entry]\n%s\nType=Application\nName=fclean 42\nPath=%s\nExec=/bin/bash ./fclean --clean\nTerminal=false\n' "$marker" "$path" > "$entry"
    update_zshrc install "$zshrc"
    mv -T -- "$tmp" "$installed"
    mv -T -- "$entry" "$desktop"
    printf 'Inicio automático instalado en %s\n' "$desktop"
)

case $mode in
    --alias) install_alias; exit 0 ;;
    --install) install_autostart; exit 0 ;;
    --uninstall)
        if present "$desktop"; then
            [[ -f $desktop && ! -L $desktop ]] && grep -Fxq -- "$marker" "$desktop" ||
                die "La entrada $desktop no pertenece a fclean."
        fi
        update_zshrc uninstall "$zshrc"
        if [[ $zshrc != "$HOME/.zshrc" ]]; then update_zshrc uninstall "$HOME/.zshrc"; fi
        if present "$desktop"; then rm -- "$desktop"; fi
        printf 'Inicio automático desactivado.\n'
        exit 0 ;;
esac

plain_directory() {
    local root=$1 dir=$2 mount
    [[ $dir == "$root/"* && -d $dir && $(realpath -e -- "$dir") == "$dir" ]] || return 1
    for mount in "${mounts[@]}"; do
        [[ $mount == "$root/"* ]] || continue
        [[ $dir != "$mount" && $dir != "$mount/"* && $mount != "$dir/"* ]] || return 1
    done
    return 0
}

app_closed() {
    local status
    if pgrep -u "$UID" -ix -- "$1" >/dev/null; then
        notice "Se omite $2 porque está en uso en este equipo."
        return 1
    else
        status=$?
        [[ $status == 1 ]] || die "No se pudo consultar si $2 está en uso."
    fi
}

# Examina los archivos como datos, sin ejecutar el intérprete del entorno.
inspect_home_venvs() {
    python3 -IS - "${1:-$home}" "$mode" "${mounts[@]}" <<'PY'
import collections
import fcntl
import functools
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time

home, mode = sys.argv[1:3]
force = mode == "--fclean"
removing_tracking = mode == "--funinstall"
scan_failed = False
mounts = set(sys.argv[3:])
uid = os.getuid()
device = os.stat(home).st_dev
pruned = mounts | {os.path.join(home, "sgoinfre"), os.path.join(home, "goinfre")}
if force:
    # Algunas extensiones distribuyen su propio intérprete y paquetes Python.
    pruned.update(os.path.join(home, editor, "extensions") for editor in (
        ".vscode", ".vscode-insiders", ".vscode-oss", ".vscode-server", ".vscode-server-insiders",
    ))
    if os.environ.get("VSCODE_EXTENSIONS"):
        pruned.add(os.path.realpath(os.environ["VSCODE_EXTENSIONS"]))
if not force and not removing_tracking:
    pruned.update(os.path.join(home, path) for path in (
        ".cache", ".local/share/Trash", ".npm/_cacache", ".bun/install/cache",
        ".local/share/pypoetry/venv", ".local/share/pipx", ".local/pipx", ".local/share/uv/tools",
    ))
venv_entries = {"bin", "include", "lib", "lib64", "share", "etc", "pyvenv.cfg",
                ".gitignore", ".Python", "CACHEDIR.TAG", ".fclean-keep"}
if force:
    venv_entries.update({"pipx_metadata.json", "uv-receipt.toml", ".lock"})
cutoff = time.time() - 5 * 24 * 60 * 60
module = "_fclean_venv_usage_v1.py"
startup = "fclean_venv_usage_v1.pth"
running = ".fclean-running-"
token_content = b"fclean-running-v3\n"
token_name = re.compile(re.escape(running) + r"([0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12})\.([1-9][0-9]*)\.[a-z0-9_]{8}")
legacy_hooks = {
    "dae393ce8febaedee6a561dc8cf8f8a0b4af34ce24b7b0009c070971ae03dea2",  # marcadores vacíos
    "866f136a39ae1bf70c4506a81c3e0583cdf115f5e89fc642dc6801fad6453e10",  # primer módulo con bloqueo
}
hook = b'''# Seguimiento de uso de este venv por fclean.
import atexit
import fcntl
import os
import tempfile

_session = None

def _record():
    global _session
    if _session is not None:  # A forked child must release its copy of the parent's descriptor.
        inherited_fd = _session[2]
        _session = None
        if inherited_fd is not None:
            os.close(inherited_fd)
    site = os.path.dirname(__file__)
    stamp = os.path.join(site, "fclean_venv_usage_v1.pth")
    os.utime(stamp, follow_symlinks=False)
    pid = os.getpid()
    with open("/proc/sys/kernel/random/boot_id", encoding="ascii") as stream:
        boot = stream.read().strip()
    fd, token = tempfile.mkstemp(prefix=f".fclean-running-{boot}.{pid}.", dir=site)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if _locks_visible(fd):
            os.write(fd, b"fclean-running-v3\\n")
    except OSError:
        os.close(fd)
        fd = None
    _session = pid, token, fd, stamp

def _finish():
    if _session is None:
        return
    pid, token, fd, stamp = _session
    if os.getpid() != pid:
        return
    try:
        os.utime(stamp, follow_symlinks=False)
    except OSError:
        pass
    try:
        os.unlink(token)
    except OSError:
        pass
    if fd is not None:
        try:
            os.close(fd)
        except OSError:
            pass

def _locks_visible(fd):
    with open(f"/proc/self/fdinfo/{fd}", "rb") as stream:
        mount_id = next((line.split()[1] for line in stream if line.startswith(b"mnt_id:")), None)
    with open("/proc/self/mountinfo", "rb") as stream:
        for line in stream:
            if line.split(b" ", 1)[0] == mount_id:
                fs, _, options = line.rsplit(b" - ", 1)[1].split()
                return fs in @LOCKING_FS@ and not set(options.split(b",")).intersection(@LOCAL_LOCKS@)
    return False

def _try_record():
    try:
        _record()
    except OSError:
        pass

_try_record()
atexit.register(_finish)
os.register_at_fork(after_in_child=_try_record)
'''
# El creador y el lector del marcador usan la misma lista de montajes compatibles.
locking_fs = (b"ext2", b"ext3", b"ext4", b"xfs", b"btrfs", b"tmpfs", b"overlay", b"zfs", b"nfs", b"nfs4")
local_locks = (b"nolock", b"local_lock=all", b"local_lock=flock")
hook = hook.replace(b"@LOCKING_FS@", repr(locking_fs).encode()).replace(b"@LOCAL_LOCKS@", repr(local_locks).encode())
managed = {module: hook, startup: b"import _fclean_venv_usage_v1\n"}

def venv_site(path, entries):
    if not {"bin", "lib", "pyvenv.cfg"} <= entries or (not removing_tracking and not entries <= venv_entries):
        return False  # Por ejemplo, python -m venv . dentro de un proyecto con código.
    config = os.path.join(path, "pyvenv.cfg")
    if not stat.S_ISREG(os.lstat(config).st_mode):
        return False
    for name in ("bin", "lib"):
        if not stat.S_ISDIR(os.lstat(os.path.join(path, name)).st_mode):
            return False
    python = os.path.join(path, "bin", "python")
    if not os.path.isfile(python) or not os.access(python, os.X_OK):
        return False
    with os.fdopen(os.open(config, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), "rb") as cfg:
        info = os.fstat(cfg.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != uid or info.st_size > 32768:
            return False
        content = cfg.read(32769)
        if (not re.search(rb"(?mi)^home[ \t]*=[ \t]*/", content) or
                not re.search(rb"(?mi)^include-system-site-packages[ \t]*=[ \t]*(true|false)[ \t\r]*$", content)):
            return False
    sites = []
    for version in os.listdir(os.path.join(path, "lib")):
        if re.fullmatch(r"python3\.\d+t?", version):
            version_dir = os.path.join(path, "lib", version)
            site = os.path.join(version_dir, "site-packages")
            if not os.path.islink(version_dir) and os.path.isdir(site) and not os.path.islink(site):
                sites.append(site)
    return sites[0] if len(sites) == 1 else None

def raise_scan_error(exc):
    raise exc

def project_for(path):
    parent = os.path.dirname(path)
    nearest = None
    while parent != home:
        if os.path.lexists(os.path.join(parent, ".git")):
            return parent
        if nearest is None and (any(os.path.isfile(os.path.join(parent, name)) for name in
                ("pyproject.toml", "requirements.txt", "Pipfile", "setup.py", "setup.cfg"))
                or (parent == os.path.dirname(path) and any(n.endswith(".py") for n in os.listdir(parent)))):
            nearest = parent
        parent = os.path.dirname(parent)
    return nearest

def trusted_site(path, site):
    current = site
    while current != os.path.dirname(path):
        info = os.lstat(current)
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != uid or (not force and info.st_mode & 0o022):
            return False
        current = os.path.dirname(current)
    return os.path.realpath(path) == path

def tracking_files(site_fd, create, remove):
    missing = []
    outdated = {}
    for name, expected in managed.items():
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=site_fd)
        except FileNotFoundError:
            missing.append(name)
            continue
        with os.fdopen(fd, "rb") as stream:
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode) or info.st_uid != uid or info.st_nlink != 1 or info.st_mode & 0o022:
                raise ValueError(f"archivo de seguimiento ajeno o modificado: {name!r}")
            content = stream.read(len(expected) + 1)
            if content == expected:
                continue
            if name == module and hashlib.sha256(content).hexdigest() in legacy_hooks:
                outdated[name] = info
            else:
                raise ValueError(f"archivo de seguimiento ajeno o modificado: {name!r}")
    if remove:
        # Desactiva el arranque antes de retirar el módulo, sin ejecutar el venv.
        for name in reversed(list(managed)):
            if name not in missing:
                os.unlink(name, dir_fd=site_fd)
        for name in os.listdir(site_fd):
            check_session_token(site_fd, name, uninstall=True)
        try:
            cache_fd = os.open("__pycache__", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=site_fd)
        except FileNotFoundError:
            return not missing
        try:
            cache = os.fstat(cache_fd)
            if cache.st_uid != uid or cache.st_dev != os.fstat(site_fd).st_dev:
                raise ValueError("caché de Python con propietario o dispositivo inesperado")
            removed_cache = False
            for name in os.listdir(cache_fd):
                if re.fullmatch(r"_fclean_venv_usage_v1\.cpython-\d+t?(?:\.opt-\d+)?\.pyc", name):
                    info = os.stat(name, dir_fd=cache_fd, follow_symlinks=False)
                    if stat.S_ISREG(info.st_mode) and info.st_uid == uid:
                        os.unlink(name, dir_fd=cache_fd)
                        removed_cache = True
            empty = removed_cache and not os.listdir(cache_fd)
        finally:
            os.close(cache_fd)
        if empty:
            os.rmdir("__pycache__", dir_fd=site_fd)
    elif create:
        for name in [*outdated, *missing]:  # El módulo se instala antes que el archivo de arranque.
            fd, temp = tempfile.mkstemp(dir=f"/proc/self/fd/{site_fd}", prefix=".fclean-install-")
            try:
                with os.fdopen(fd, "wb") as stream:
                    stream.write(managed[name])
                if name in outdated:
                    current = os.stat(name, dir_fd=site_fd, follow_symlinks=False)
                    if not os.path.samestat(current, outdated[name]) or current.st_ctime_ns != outdated[name].st_ctime_ns:
                        raise ValueError(f"el seguimiento cambió durante la actualización: {name!r}")
                    os.replace(temp, name, dst_dir_fd=site_fd)
                else:
                    os.link(temp, name, dst_dir_fd=site_fd)
            finally:
                try:
                    os.unlink(temp)
                except FileNotFoundError:
                    pass
        if outdated:
            os.utime(startup, dir_fd=site_fd, follow_symlinks=False)
    return not missing and not outdated

def check_tracking(site, create=False, remove=False):
    fd = os.open(site, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        if os.readlink(f"/proc/self/fd/{fd}") != site:
            raise ValueError("el directorio de paquetes cambió durante la comprobación")
        return tracking_files(fd, create, remove)
    finally:
        os.close(fd)

@functools.lru_cache(maxsize=1)
def can_check_remote_locks():
    # El recorrido ya excluye otros montajes bajo home.
    try:
        fs, options = subprocess.check_output(
            ["findmnt", "-nr", "-o", "FSTYPE,OPTIONS", "-T", home], stderr=subprocess.DEVNULL, timeout=3
        ).split()
        return fs in locking_fs and not set(options.split(b",")).intersection(local_locks)
    except (OSError, ValueError, subprocess.SubprocessError):
        return False

@functools.lru_cache(maxsize=128)
def previous_local_boot(boot):
    # Un marcador vacío anterior a los bloqueos solo guarda el arranque y el PID.
    try:
        with open("/etc/machine-id", encoding="ascii") as stream:
            machine = stream.read().strip()
        hostname = os.uname().nodename
        boot = boot.replace("-", "")
        record = json.loads(subprocess.check_output(
            ["journalctl", "--quiet", "--no-pager", "--boot=" + boot, "-n", "1", "-o", "json",
             "--output-fields=_BOOT_ID,_MACHINE_ID,_HOSTNAME", "_MACHINE_ID=" + machine, "_HOSTNAME=" + hostname],
            stderr=subprocess.DEVNULL, timeout=3))
        return (isinstance(record, dict) and record.get("_MACHINE_ID") == machine
                and record.get("_HOSTNAME") == hostname and record.get("_BOOT_ID") == boot)
    except (OSError, ValueError, subprocess.SubprocessError):
        return False

def check_session_token(site_fd, name, current_boot=None, *, uninstall=False):
    match = token_name.fullmatch(name)
    if not match:
        return
    try:
        entry = os.stat(name, dir_fd=site_fd, follow_symlinks=False)
        if not stat.S_ISREG(entry.st_mode) or entry.st_uid != uid or entry.st_nlink != 1:
            return
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=site_fd)
        with os.fdopen(fd, "rb") as stream:
            if not os.path.samestat(entry, os.fstat(fd)):
                return
            content = stream.read(len(token_content) + 1)
            if content not in (b"", b"fclean-running-v2\n", token_content):
                return
            if not uninstall:
                boot, pid = match.groups()
                if content == token_content and (boot == current_boot or can_check_remote_locks()):
                    try:
                        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
                    except OSError:
                        return  # Bloqueo activo o no verificable.
                elif boot == current_boot:
                    if os.path.exists("/proc/" + pid):
                        return
                elif not previous_local_boot(boot):
                    path = os.path.join(os.readlink(f"/proc/self/fd/{site_fd}"), name)
                    print(f"Marcador de otro equipo sin bloqueo verificable: {path!r}. "
                          "Comprueba que su intérprete terminó antes de retirarlo.", file=sys.stderr)
                    return
            if os.path.samestat(entry, os.stat(name, dir_fd=site_fd, follow_symlinks=False)):
                if not uninstall:
                    # Concede cinco días completos desde que se detecta el cierre.
                    os.utime(startup, dir_fd=site_fd, follow_symlinks=False)
                os.unlink(name, dir_fd=site_fd)
    except FileNotFoundError:
        pass  # El intérprete puede haber salido durante la comprobación.

def running_sessions(site):
    site_fd = os.open(site, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        tokens = [n for n in os.listdir(site_fd) if n.startswith(running)]
        if tokens and mode == "--clean":
            with open("/proc/sys/kernel/random/boot_id", encoding="ascii") as stream:
                current_boot = stream.read().strip()
            for name in tokens:
                check_session_token(site_fd, name, current_boot)
        return bool(tokens)  # Incluso si se han retirado todos, esta ejecución conserva el venv.
    finally:
        os.close(site_fd)

def active_locally(path, project):
    if os.path.realpath(os.environ.get("VIRTUAL_ENV", "")) == path:
        return True
    for pid in os.listdir("/proc"):
        if not pid.isdecimal():
            continue
        proc = os.path.join("/proc", pid)
        try:
            if os.stat(proc).st_uid != uid:
                continue
            cwd = os.readlink(proc + "/cwd")
            if cwd == project or cwd.startswith(project + "/"):
                return True
            with open(proc + "/cmdline", "rb") as stream:
                args = stream.read().split(b"\0")
            project_arg = os.fsencode(project)
            if any(arg == project_arg or arg.startswith(project_arg + b"/") for arg in args):
                return True
            with open(proc + "/environ", "rb") as stream:
                if b"VIRTUAL_ENV=" + os.fsencode(path) in stream.read().split(b"\0"):
                    return True
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            continue
    return False

def project_quiet(project, env, staging=None):
    for base, dirs, files in os.walk(project, onerror=raise_scan_error, followlinks=False):
        dirs[:] = [n for n in dirs if os.path.join(base, n) not in (env, staging)]
        for name in ([""] if base == project else []) + dirs + files:
            item = os.path.join(base, name) if name else base
            if staging and item == os.path.dirname(env):
                continue  # Acabamos de mover el venv dentro de este mismo directorio.
            info = os.lstat(item)
            last = max(info.st_mtime, info.st_ctime)
            if stat.S_ISREG(info.st_mode) and name not in {"pyvenv.cfg", module, startup}:
                last = max(last, info.st_atime)
            if item in mounts or info.st_dev != device or name == ".fclean-keep" or last > cutoff:
                return False
    return True

def eligible_size(path, site, moved=False):
    # Una consulta de fclean puede leer estos tres archivos. Su atime no mide uso.
    metadata = {os.path.join(path, "pyvenv.cfg"), *(os.path.join(site, n) for n in managed)}
    links = collections.Counter()
    blocks = 0
    for base, dirs, files in os.walk(path, onerror=raise_scan_error, followlinks=False):
        if base != path and {".git", ".hg", ".svn", "conda-meta", "pyvenv.cfg"}.intersection(dirs + files):
            return None
        for name in ([None] if base == path else []) + dirs + files:
            child = os.path.join(base, name) if name is not None else base
            info = os.lstat(child)
            if info.st_uid != uid or info.st_dev != device or child in mounts or (name or "").startswith(".nfs") or name == ".fclean-keep":
                return None
            if not force:
                # El rename final cambia el ctime de la raíz aunque su contenido sea idéntico.
                latest = info.st_mtime if moved and child == path else max(info.st_mtime, info.st_ctime)
                if stat.S_ISREG(info.st_mode) and child not in metadata:
                    latest = max(latest, info.st_atime)
                if latest > cutoff or (name or "").startswith(running):
                    return None
            if not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode)):
                return None
            if stat.S_ISDIR(info.st_mode):
                blocks += info.st_blocks
            else:
                links[info.st_ino] += 1
                if links[info.st_ino] == info.st_nlink:
                    blocks += info.st_blocks
    return (blocks + 1) // 2

def contains_mount(path):
    # La tabla inicial podría haber cambiado. Incluye bind mounts del mismo dispositivo.
    escaped = os.fsencode(path)
    for raw, mount_escape in ((b"\\", br"\134"), (b" ", br"\040"), (b"\t", br"\011"), (b"\n", br"\012")):
        escaped = escaped.replace(raw, mount_escape)
    with open("/proc/self/mountinfo", "rb") as stream:
        for line in stream:
            mount = line.split()[4]
            if mount == escaped or mount.startswith(escaped + b"/"):
                return True
    return False

def keep_in_ancestors(path):
    parent = os.path.dirname(path)
    while parent != home and parent != os.path.dirname(parent):
        try:
            os.lstat(os.path.join(parent, ".fclean-keep"))
            return True
        except FileNotFoundError:
            pass
        parent = os.path.dirname(parent)
    return False

def inactive_project(path, site):
    project = project_for(path)
    if not project:
        if mode == "--dry-run":
            print(f"Venv conservado sin proyecto identificable: {path!r}", file=sys.stderr)
        return
    if os.path.lexists(os.path.join(path, ".fclean-keep")) or keep_in_ancestors(path):
        return
    if not check_tracking(site, mode == "--clean"):
        action = "Seguimiento iniciado" if mode == "--clean" else "Se iniciaría el seguimiento"
        print(f"{action} para {path!r} (plazo de 5 días completos).", file=sys.stderr)
        return
    stamp = os.path.join(site, startup)
    if os.stat(stamp).st_mtime > cutoff or running_sessions(site) or active_locally(path, project):
        return
    if not project_quiet(project, path):
        return
    return project

def process_venv(path, site, identity):
    global scan_failed
    if not trusted_site(path, site):
        if mode == "--dry-run" or removing_tracking:
            print(f"Venv conservado por sus permisos o enlaces: {path!r}", file=sys.stderr)
        if removing_tracking:
            scan_failed = True
        return
    if removing_tracking:
        check_tracking(site, remove=True)
        return
    if force and keep_in_ancestors(path):
        return
    project = None if force else inactive_project(path, site)
    if not force and not project:
        return
    size = eligible_size(path, site)
    if size is None:
        return
    if mode in ("--clean", "--fclean"):
        # Apartar el directorio permite verificar su identidad antes del borrado.
        parent = os.path.dirname(path)
        staging = tempfile.mkdtemp(prefix=".fclean-venv-", dir=parent)
        moved = os.path.join(staging, "venv")
        try:
            os.rename(path, moved)
            moved_site = os.path.join(moved, os.path.relpath(site, path))
            if (not os.path.samestat(identity, os.lstat(moved)) or contains_mount(moved) or
                    not trusted_site(moved, moved_site) or not set(os.listdir(moved)) <= venv_entries or
                    eligible_size(moved, moved_site, moved=True) is None or keep_in_ancestors(path)):
                raise ValueError("el entorno cambió durante la limpieza")
            if not force and (not project_quiet(project, path, staging) or not check_tracking(moved_site) or
                    os.stat(os.path.join(moved_site, startup)).st_mtime > cutoff):
                raise ValueError("el seguimiento o el proyecto cambió durante la limpieza")
            shutil.rmtree(moved)
        finally:
            if os.path.lexists(moved):
                subprocess.run(["mv", "-nT", "--", moved, path], check=False)
                if os.path.lexists(moved):
                    print(f"Original de recuperación: {moved!r}", file=sys.stderr)
            if not os.path.lexists(moved):
                os.rmdir(staging)
    reason = "venv, limpieza manual" if force else "venv y proyecto sin actividad observable durante 5 días"
    print(f"{size}\t{path!r} ({reason})")

def scan_error(exc):
    global scan_failed
    scan_failed = True
    print(f"Se omite la búsqueda de venvs en {exc.filename!r}: {exc.strerror}", file=sys.stderr)

for path, dirs, files in os.walk(home, onerror=scan_error, followlinks=False):
    try:
        entry = os.lstat(path)
        if not stat.S_ISDIR(entry.st_mode) or entry.st_dev != device or entry.st_uid != uid:
            dirs.clear()
            continue
        if force and os.path.basename(os.path.dirname(path)) == "extensions" and "package.json" in files:
            dirs.clear()
            continue
        if path != home and "pyvenv.cfg" in files:
            entries = set(dirs + files)
            site = venv_site(path, entries)
            if site and not any(m == path or m.startswith(path + "/") for m in mounts):
                dirs.clear()
                process_venv(path, site, entry)
                continue
        dirs[:] = [d for d in dirs if d not in {".git", ".hg", ".svn"}
                   and not d.startswith(".fclean-venv-")
                   and os.path.join(path, d) not in pruned
                   and (force or removing_tracking or (d != "node_modules" and
                        not (d == "cache" and os.path.dirname(path) == os.path.join(home, ".var/app"))))]
    except OSError as exc:
        scan_error(exc)
        dirs.clear()
    except ValueError as exc:
        scan_failed = True
        print(f"Se conserva {path!r}: {exc}", file=sys.stderr)
        dirs.clear()
if removing_tracking and scan_failed:
    sys.exit(1)
PY
}

# Solo retira archivos conocidos de la instalación y sus copias auxiliares.
uninstall_files() {
    python3 -IS - "$1" "$installed" "$runtime" "$zshrc" "$HOME/.zshrc" "${mounts[@]}" <<'PY'
import glob
import os
import re
import shutil
import stat
import sys

phase, installed, runtime, zshrc, default_zshrc = sys.argv[1:6]
mounts = set(sys.argv[6:])
directory = os.path.dirname(installed)
uid = os.getuid()
signature = b"# fclean para las sesiones de usuario de Ubuntu del campus 42."

def owned_entry(path):
    info = os.lstat(path)
    if info.st_uid != uid or not (stat.S_ISREG(info.st_mode) or stat.S_ISDIR(info.st_mode)):
        raise ValueError(f"archivo ajeno, enlace o tipo inesperado: {path!r}")
    return info

def check_script(path):
    owned_entry(path)
    with open(path, "rb") as stream:
        if signature not in stream.read(512).splitlines():
            raise ValueError(f"el archivo no pertenece a fclean: {path!r}")

def check_directory(path, *, installation=False):
    info = owned_entry(path)
    if not stat.S_ISDIR(info.st_mode):
        raise ValueError(f"se esperaba un directorio: {path!r}")
    physical = os.path.realpath(path)
    if any(m == physical or m.startswith(physical + "/") for m in mounts):
        raise ValueError(f"hay un montaje en la carpeta que se quiere retirar: {path!r}")
    for name in os.listdir(path):
        child = os.path.join(path, name)
        entry = owned_entry(child)
        if installation:
            if re.fullmatch(r"\.fclean-update\.[A-Za-z0-9]{8}", name):
                check_directory(child)
                continue
            known = name in {"fclean", "fclean.etag", "fclean.update.lock"} or re.fullmatch(
                r"\.instalacion\.[A-Za-z0-9]{8}", name)
        else:
            known = name in {"script", "request", "etag", "state"}
        if not known or not stat.S_ISREG(entry.st_mode):
            raise ValueError(f"contenido inesperado en la instalación: {child!r}")
        if installation and name == "fclean":
            check_script(child)

try:
    if os.path.lexists(directory):
        check_directory(directory, installation=True)
    auxiliaries = set()
    update_dirs = set()
    for name in os.listdir(runtime):
        path = os.path.join(runtime, name)
        if re.fullmatch(r"fclean-[0-9a-f]{64}(?:\.etag|\.update\.lock)?", name):
            info = owned_entry(path)
            if not stat.S_ISREG(info.st_mode):
                raise ValueError(f"copia de ejecución inesperada: {path!r}")
            if re.fullmatch(r"fclean-[0-9a-f]{64}", name):
                check_script(path)
            auxiliaries.add(path)
        elif re.fullmatch(r"\.fclean-initial\.[A-Za-z0-9]{8}", name):
            if not stat.S_ISREG(owned_entry(path).st_mode):
                raise ValueError(f"copia temporal inesperada: {path!r}")
            auxiliaries.add(path)
        elif re.fullmatch(r"\.fclean-update\.[A-Za-z0-9]{8}", name):
            check_directory(path)
            update_dirs.add(path)
    prefixes = {os.path.join(os.path.dirname(directory), "autostart", ".42-fclean.")}
    for file in {zshrc, default_zshrc, os.path.realpath(zshrc), os.path.realpath(default_zshrc)}:
        prefixes.update((file + ".antes-de-fclean.", file + ".fclean."))
    for prefix in prefixes:
        for path in glob.glob(glob.escape(prefix) + "*"):
            if re.fullmatch(r"[A-Za-z0-9]{8}", path[len(prefix):]):
                if prefix.endswith(".antes-de-fclean."):
                    info = os.lstat(path)
                    if not stat.S_ISREG(info.st_mode) or info.st_uid != uid or info.st_nlink != 1:
                        continue
                if not stat.S_ISREG(owned_entry(path).st_mode):
                    raise ValueError(f"copia de configuración inesperada: {path!r}")
                auxiliaries.add(path)
    if phase == "remove":
        for path in sorted(auxiliaries):
            os.unlink(path)
        for path in sorted(update_dirs):
            shutil.rmtree(path)
        # El script puede estar ejecutándose desde esta misma carpeta.
        if os.path.lexists(directory):
            check_directory(directory, installation=True)
            shutil.rmtree(directory)
except (OSError, ValueError) as exc:
    print(f"No se pudo completar la desinstalación de fclean: {exc}", file=sys.stderr)
    sys.exit(1)
PY
}

# Vacía el contenido desde el directorio ya validado. Las operaciones relativas
# al descriptor evitan seguir un enlace si una entrada cambia durante el recorrido.
clean_contents() {
    python3 -IS - "$mode" "$@" <<'PY'
import errno
import json
import os
import stat
import sys

apply = sys.argv[1] in ("--clean", "--fclean")
root = sys.argv[2]
# La regla carpeta/* selecciona entradas visibles en la raíz y todo lo que contienen.
visible_children = sys.argv[3] == "*"
obsolete_extensions = sys.argv[3] == "obsolete"
full_tree = sys.argv[3] == "all" or obsolete_extensions
remove_cached_venvs = full_tree and sys.argv[1] == "--fclean"
guarded = not (visible_children or full_tree)
in_trash = sys.argv[4] == "trash"
keep = {"huggingface/token", "huggingface/stored_tokens"}
flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
markers = {".git", ".hg", ".svn", "pyvenv.cfg", "conda-meta"}
uid = os.getuid()
files = blocks = directories = 0
remaining_links = {}

def mount_id(fd):
    with open(f"/proc/self/fdinfo/{fd}", encoding="ascii") as info:
        return next(line for line in info if line.startswith("mnt_id:"))

def venv_has_keep(fd, mount):
    names = os.listdir(fd)
    if ".fclean-keep" in names:
        return True
    for name in names:
        try:
            entry = os.stat(name, dir_fd=fd, follow_symlinks=False)
            if stat.S_ISDIR(entry.st_mode):
                child = os.open(name, flags, dir_fd=fd)
                try:
                    if os.path.samestat(entry, os.fstat(child)) and mount_id(child) == mount:
                        if venv_has_keep(child, mount):
                            return True
                finally:
                    os.close(child)
        except FileNotFoundError:
            continue
    return False

def clean(fd, relative, mount, apply):
    global files, blocks, directories
    if obsolete_extensions and not os.access(".", os.W_OK | os.X_OK, dir_fd=fd):
        return False
    names = os.listdir(fd)
    if "pyvenv.cfg" in names and not (in_trash or obsolete_extensions):
        if not remove_cached_venvs or venv_has_keep(fd, mount):
            return False
    if guarded and (markers.intersection(names) or {"HEAD", "objects", "refs"}.issubset(names)):
        return False
    empty = True
    for name in names:
        if obsolete_extensions and apply and not relative and name == "package.json":
            continue  # Conserva el manifiesto si el recorrido se interrumpe.
        path = os.path.join(relative, name)
        if (name.startswith(".nfs") or (visible_children and not relative and name.startswith("."))
                or (guarded and (path in keep or name in {".venv", "venv"}))):
            empty = False
            continue
        try:
            entry = os.stat(name, dir_fd=fd, follow_symlinks=False)
            if entry.st_uid != uid:
                empty = False
            elif stat.S_ISDIR(entry.st_mode):
                child = os.open(name, flags, dir_fd=fd)
                try:
                    removable = (os.path.samestat(entry, os.fstat(child))
                                 and mount_id(child) == mount and clean(child, path, mount, apply))
                    if removable and apply:
                        current = os.stat(name, dir_fd=fd, follow_symlinks=False)
                        if os.path.samestat(entry, current):
                            os.rmdir(name, dir_fd=fd)
                        else:
                            removable = False
                finally:
                    os.close(child)
                if removable:
                    directories += 1
                    blocks += entry.st_blocks
                else:
                    empty = False
            elif (not guarded and not obsolete_extensions) or stat.S_ISREG(entry.st_mode) or stat.S_ISLNK(entry.st_mode):
                if apply:
                    os.unlink(name, dir_fd=fd)
                files += 1
                # Bun puede compartir un inodo con un node_modules o con otro
                # archivo de la caché. Cuenta sus bloques al quitar el último enlace.
                key = (entry.st_dev, entry.st_ino)
                left = remaining_links.get(key, entry.st_nlink) - 1
                if left:
                    remaining_links[key] = left
                else:
                    remaining_links.pop(key, None)
                    blocks += entry.st_blocks
            else:
                empty = False
        except FileNotFoundError:
            continue
        except OSError as exc:
            empty = False
            if exc.errno != errno.ENOTEMPTY:
                print(f"Se omite {os.path.join(root, path)!r}: {exc.strerror}", file=sys.stderr)
    return empty

def read_extension_json(path, dir_fd=None):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
    with os.fdopen(fd, encoding="utf-8") as stream:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != uid:
            raise ValueError(f"registro de extensiones inesperado: {path!r}")
        return json.load(stream)

def installed_extensions(fd, editor_roots):
    registries = [("extensions.json", fd)]
    for editor_root in set(editor_roots):
        profiles = os.path.join(editor_root, "User", "profiles")
        try:
            with os.scandir(profiles) as entries:
                registries.extend((os.path.join(entry.path, "extensions.json"), None)
                                  for entry in entries if entry.is_dir())
        except FileNotFoundError:
            continue
    locations, versions = set(), set()
    for path, parent_fd in registries:
        try:
            entries = read_extension_json(path, parent_fd)
        except FileNotFoundError:
            continue
        if not isinstance(entries, list) or any(not isinstance(entry, dict) for entry in entries):
            raise ValueError(f"registro de extensiones inválido: {path!r}")
        for entry in entries:
            location = entry.get("location")
            paths = (entry.get("relativeLocation"), location.get("path") if isinstance(location, dict) else None)
            names = {os.path.basename(value.rstrip("/")).casefold() for value in paths if isinstance(value, str) and value}
            if names:
                locations.update(names)
                continue
            identifier = entry.get("identifier")
            name = identifier.get("id") if isinstance(identifier, dict) else None
            version = entry.get("version")
            if not isinstance(name, str) or not isinstance(version, str):
                raise ValueError(f"extensión sin ubicación o versión en {path!r}")
            versions.add((name.casefold(), version))
    return locations, versions

def extension_manifest(fd):
    manifest = read_extension_json("package.json", fd)
    if not isinstance(manifest, dict):
        raise ValueError("package.json inválido")
    publisher, name, version = (manifest.get(field) for field in ("publisher", "name", "version"))
    if not all(isinstance(field, str) and field for field in (publisher, name, version)):
        raise ValueError("package.json sin editor, nombre o versión")
    identifier = f"{publisher}.{name}".casefold()
    metadata = manifest.get("__metadata")
    platform = metadata.get("targetPlatform") if isinstance(metadata, dict) else None
    suffix = f"-{platform}" if platform and platform != "undefined" else ""
    return f"{identifier}-{version}{suffix}", (identifier, version)

def clean_obsolete(fd, mount, editor_roots):
    global files, blocks, directories
    try:
        marked = read_extension_json(".obsolete", fd)
    except FileNotFoundError:
        return
    if not isinstance(marked, dict):
        raise ValueError(".obsolete debe ser un objeto JSON")
    locations, versions = installed_extensions(fd, editor_roots)
    for name, remove in marked.items():
        if (remove is not True or not name or name.startswith(".") or "/" in name or "\0" in name
                or name.casefold() in locations):
            continue
        path = os.path.join(root, name)
        try:
            entry = os.stat(name, dir_fd=fd, follow_symlinks=False)
            if not stat.S_ISDIR(entry.st_mode) or entry.st_uid != uid:
                continue
            child = os.open(name, flags, dir_fd=fd)
            try:
                if not os.path.samestat(entry, os.fstat(child)) or mount_id(child) != mount:
                    continue
                key, version = extension_manifest(child)
                if key.casefold() != name.casefold() or version in versions:
                    continue
                files = blocks = directories = 0
                remaining_links.clear()
                if not clean(child, "", mount, False):
                    continue
                size = (blocks + entry.st_blocks + 1) // 2
                if apply:
                    current = read_extension_json(".obsolete", fd)
                    locations, versions = installed_extensions(fd, editor_roots)
                    if (not isinstance(current, dict) or current.get(name) is not True
                            or name.casefold() in locations or version in versions
                            or not os.path.samestat(entry, os.stat(name, dir_fd=fd, follow_symlinks=False))):
                        continue
                    if not clean(child, "", mount, True):
                        continue
                    if not os.path.samestat(entry, os.stat(name, dir_fd=fd, follow_symlinks=False)):
                        continue
                    os.unlink("package.json", dir_fd=child)
                    os.rmdir(name, dir_fd=fd)
                print(f"{size}\t{path!r} (extensión marcada en .obsolete)")
            finally:
                os.close(child)
        except FileNotFoundError:
            continue
        except (OSError, ValueError) as exc:
            print(f"Se omite {path!r}: {exc}", file=sys.stderr)

fd = os.open(".", flags)
try:
    if os.fstat(fd).st_uid == uid:
        if obsolete_extensions:
            clean_obsolete(fd, mount_id(fd), sys.argv[5:])
        else:
            clean(fd, "", mount_id(fd), apply)
except (OSError, ValueError) as exc:
    print(f"Se omite {root!r}: {exc}", file=sys.stderr)
finally:
    os.close(fd)
if not obsolete_extensions and (files or directories):
    print(f"{(blocks + 1) // 2}\t{root!r} ({files} archivos y enlaces, {directories} directorios)")
PY
}

clean_directory() (
    local dir=$1 pattern=${2:-} root=$home src relative='' blocks name
    local action=()
    [[ -d $dir && -z ${listed_dirs[$dir]:-} ]] || return 0
    if [[ -n $sgo_root && ( $dir == "$sgo/.cache" || $dir == "$sgo/.vscode/extensions/"* ) ]]; then
        relative=${dir#"$sgo/"}
    else
        for src in "${!managed_dirs[@]}"; do
            if [[ $dir == "$src" || $dir == "$src/"* ]]; then
                relative="${managed_dirs[$src]}${dir#"$src"}"
                [[ $(realpath -e -- "$src") == "$sgo_root/${managed_dirs[$src]}" ]] || return 0
                break
            fi
        done
    fi
    if [[ -n $relative ]]; then
        trusted_destination "$sgo/$relative" || return 0
        root=$sgo_root
        dir="$root/$relative"
    fi
    if ! plain_directory "$root" "$dir"; then
        notice "Se omite el directorio enlazado o montado en $dir"
        return 0
    fi
    # Mantiene una referencia al directorio aunque otra sesión lo renombre.
    cd -P -- "$dir" || { notice "Se omite el directorio inaccesible $dir"; return 0; }
    [[ $(pwd -P) == "$dir" ]] || return 0
    if [[ $root == "$sgo_root" ]]; then
        [[ $(stat -Lc '%d:%i' -- "$root") == "$sgo_identity" &&
           $(stat -c %d -- .) == "${sgo_identity%:*}" ]] || return 0
    fi
    if [[ $pattern == obsolete ]]; then
        shift 2
        clean_contents "$dir" "$pattern" extensions "$@"
        return
    fi
    if [[ -z $pattern || $pattern == '*' || $pattern == all ]]; then
        if [[ $1 == "$home/.local/share/Trash" ]]; then
            clean_contents "$dir" "$pattern" trash
        else
            clean_contents "$dir" "$pattern" cache
        fi
        return
    fi
    if [[ $mode != --dry-run ]]; then action=(-delete); fi
    LC_ALL=C find -P . -xdev -ignore_readdir_race -regextype posix-extended -mindepth 1 -maxdepth 1 \
        -type f -uid "$UID" -links 1 -regex "\./($pattern)" \
        "${action[@]}" -printf '%k\t%f\n' |
        while IFS=$'\t' read -r blocks name; do
            printf '%s\t%q\n' "$blocks" "$dir/$name"
        done
)

chromium_discards() {
    local base dir
    for base in "$@"; do
        # Chromium aparta una caché anterior en old_Cache_Data_000..099.
        for dir in "$base"/Cache/old_Cache_Data_0[0-9][0-9]; do
            clean_directory "$dir" '[0-9a-f]{16}_[01s]'
        done
    done
}

clean_named_caches() {
    local base=$1 name
    shift
    for name in "$@"; do clean_directory "$base/$name"; done
}

# Las dos copias pueden coexistir antes de migrar o después de quitar un enlace.
clean_general_cache() {
    local src="$home/.cache" dst="$sgo/.cache"
    if [[ -n $sgo_root && -d $dst ]] && trusted_destination "$dst"; then
        clean_directory "$dst" all
        if [[ $src -ef $dst ]]; then return 0; fi
    fi
    clean_directory "$src" all
}

clean_browser_profiles() {
    local base profile
    for base in "$@"; do
        [[ -d $base ]] || continue
        clean_named_caches "$base" component_crx_cache extensions_crx_cache
        for profile in "$base/Default" "$base"/Profile\ [0-9]*; do
            [[ ${profile##*/} == Default || ${profile##*/} =~ ^Profile\ [0-9]+$ ]] || continue
            clean_named_caches "$profile" Cache 'Code Cache' GPUCache 'File System' \
                'Service Worker/ScriptCache' 'Service Worker/CacheStorage'
        done
    done
}

clean_extension_caches() {
    local installed_ext="$home/.vscode/extensions" root extension
    local -a roots=()
    if plain_directory "$home" "$installed_ext"; then roots+=("$installed_ext"); fi
    if [[ -n $sgo_root ]] && trusted_destination "$sgo/.vscode/extensions" &&
       plain_directory "$sgo_root" "$sgo_root/.vscode/extensions"; then
        roots+=("$sgo/.vscode/extensions")
    fi
    for root in "${roots[@]}"; do
        for extension in "$root"/*; do
            [[ -d $extension && ! -L $extension && -f $extension/package.json &&
               ! -L $extension/package.json ]] || continue
            # Una extensión puede distribuir índices en .cache. Solo tocar descartes conocidos.
            chromium_discards "$extension" "$extension/.cache" "$extension/cache" "$extension/dist/.cache"
        done
    done
}

clean_app_caches() {
    local dir profile
    local apps="$home/.var/app"
    local chrome="$apps/com.google.Chrome/config/google-chrome"
    local code="$apps/com.visualstudio.code/config/Code"
    local -A listed_dirs=()
    local -a editor_roots=("$home/.config/Code" "$home/.config/Code - Insiders" "$home/.config/Code - OSS" "$code"
        "$home/.config/VSCodium" "$apps/com.vscodium.codium/config/VSCodium")
    local -a targets=(
        "$home/.local/share/Trash" "$home/.npm/_cacache" "$home/.bun/install/cache"
        "$apps"/*/cache "$chrome/component_crx_cache" "$chrome/extensions_crx_cache"
        "$code/Cache" "$code/CachedData" "$code/CachedExtensionVSIXs"
        "$apps/com.discordapp.Discord/config/discord/Cache"
    )
    for profile in "$chrome/Default" "$chrome"/Profile\ [0-9]; do
        targets+=("$profile/File System" "$profile/Service Worker/CacheStorage" "$profile/Service Worker/ScriptCache")
    done
    clean_general_cache
    for dir in "${targets[@]}"; do
        clean_directory "$dir" '*'
        # Las reglas adicionales no deben repetir la ruta ni contarla en la vista previa.
        listed_dirs["$dir"]=1
    done

    clean_browser_profiles \
        "$home/.config"/{google-chrome,google-chrome-beta,google-chrome-unstable} \
        "$chrome" \
        "$home/.config/chromium" "$home/snap/chromium/common/chromium" \
        "$apps/org.chromium.Chromium/config/chromium" \
        "$home/.config/BraveSoftware/Brave-Browser" "$apps/com.brave.Browser/config/BraveSoftware/Brave-Browser"
    clean_directory "$home/snap/chromium/common/.cache"
    clean_directory "$home/snap/firefox/common/.cache"

    for dir in "$home/.config/discord" "$apps/com.discordapp.Discord/config/discord" \
               "$home/.config/Slack" "$apps/com.slack.Slack/config/Slack"; do
        clean_named_caches "$dir" Cache 'Code Cache' GPUCache 'Service Worker/ScriptCache' 'Service Worker/CacheStorage'
    done
    for dir in "${editor_roots[@]}"; do
        clean_named_caches "$dir" Cache 'Code Cache' GPUCache CachedData CachedExtensionVSIXs
    done
    clean_extension_caches
    if present "$home/.vscode/extensions/.obsolete"; then
        clean_directory "$home/.vscode/extensions" obsolete "${editor_roots[@]}" \
            "$config/Code" "$config/Code - Insiders" "$config/Code - OSS" "$config/VSCodium"
    fi
}

# Sólo se crean destinos en un sistema de archivos distinto del home.
# En algunos campus el montaje está en la carpeta personal, en otros en su padre.
sgo_available() {
    local probe="$HOME/sgoinfre" home_dev sgo_dev mount
    [[ -d $probe && ! -L $sgo ]] || return 1
    if present "$sgo"; then
        [[ -d $sgo && -O $sgo ]] || return 1
        probe=$sgo
    fi
    [[ -w $probe && -x $probe ]] || return 1
    home_dev=$(stat -Lc %d -- "$home") && sgo_dev=$(stat -Lc %d -- "$probe") &&
        mount=$(findmnt -nr -o TARGET -T "$probe") &&
        [[ -n $mount && $mount != / && $home_dev != "$sgo_dev" ]]
}

# Dentro del directorio personal de sgoinfre se rechazan componentes enlazados
# y directorios modificables por otros usuarios (aquí se ejecutan extensiones).
trusted_destination() {
    local path=$1 perms root physical mount
    [[ $path == "$sgo" || $path == "$sgo/"* ]] || return 1
    case "/${path#"$sgo"}/" in */../*|*/./*) return 1 ;; esac
    if [[ -d $sgo ]]; then
        root=$(realpath -e -- "$sgo") || return 1
        physical="$root${path#"$sgo"}"
        for mount in "${mounts[@]}"; do
            [[ $mount == "$root/"* ]] || continue
            [[ $physical != "$mount" && $physical != "$mount/"* ]] || return 1
        done
    fi
    while [[ $path == "$sgo" || $path == "$sgo/"* ]]; do
        if present "$path"; then
            [[ -d $path && ! -L $path && -O $path ]] || return 1
            perms=$(stat -c %a -- "$path") || return 1
            (( (8#$perms & 0022) == 0 )) || return 1
        fi
        path=${path%/*}
    done
}

# Crea únicamente la carpeta de la cuenta en el nivel compartido. Las demás
# creaciones se hacen desde dentro de esa carpeta y con la máscara privada 077.
ensure_sgo_directories() (
    local dst
    if ! sgo_available; then
        if [[ $mode == --prepare-env ]]; then exit 1; fi
        die 'sgoinfre no está montado como almacenamiento separado y escribible.'
    fi
    if ! present "$sgo"; then
        cd -P -- "$HOME/sgoinfre"
        mkdir -m 700 -- "$USER" || [[ -d $sgo && ! -L $sgo && -O $sgo ]] || exit 1
        sgo_available || die "No se pudo verificar el montaje de $sgo"
    fi
    trusted_destination "$sgo" || die "Directorio personal no válido: $sgo"
    cd -P -- "$sgo"
    for dst in "$@"; do
        trusted_destination "$dst" || die "Destino no válido en sgoinfre: $dst"
        if [[ $dst != "$sgo" && ! -d $dst ]]; then mkdir -p -- "./${dst#"$sgo/"}"; fi
    done
)

register_migrated_link() {
    local src="$home/$1" relative=$2
    [[ -L $src && -d $src ]] || return 0
    [[ $(realpath -e -- "${src%/*}") == "${src%/*}" ]] || return 0
    [[ $(realpath -e -- "$src") == "$sgo_root/$relative" ]] || return 0
    trusted_destination "$sgo/$relative" || { notice "Se omite el destino con permisos o enlaces inesperados: $sgo/$relative"; return 0; }
    managed_dirs["$src"]=$relative
}

repair_link() {
    local src=$1 dst=$2 resolved expected
    [[ -L $src && ! -e $src ]] || return 0
    [[ $(realpath -e -- "${src%/*}") == "${src%/*}" ]] || return 0
    resolved=$(realpath -m -- "$src") && expected=$(realpath -m -- "$dst") || return 0
    [[ $resolved == "$expected" ]] || return 0
    if ! trusted_destination "$dst"; then
        if [[ $mode == --migrate || $mode == --migrate-cache ]]; then
            die "Revisa el propietario, permisos y enlaces de $dst"
        fi
        notice "Se omite la reparación de $src por los permisos o enlaces de $dst"
        return 0
    fi
    if [[ $mode == --dry-run ]]; then
        printf 'Se recrearía el destino vacío de %s\n' "$src"
    else
        ensure_sgo_directories "$dst"
        printf 'Destino vacío recreado para %s\n' "$src"
    fi
}

repair_disposable_links() {
    local name
    repair_link "$home/.cache" "$sgo/.cache"
    for name in Cache CachedData CachedExtensionVSIXs; do
        repair_link "$home/.config/Code/$name" "$sgo/vscode_config/$name"
    done
    for name in .gemini .local/share .config/Code/User/workspaceStorage; do
        if [[ -L $home/$name && ! -e $home/$name ]]; then
            notice "Enlace a datos persistentes sin destino: $home/$name. Revisa tu copia de seguridad."
        fi
    done
}

check_cache_copy() {
    # --existing comprueba solo las coincidencias antes de combinar. Sin él,
    # cualquier archivo del original ausente o distinto impide retirarlo.
    local src=$1 dst=$2 changes
    shift 2
    # Los directorios personales de destino pueden tener permisos más privados.
    changes=$(rsync -rclpAXni --out-format='%i' "$@" -- "$src/" "$dst/" | awk '!/^[.]d/') ||
        die 'No se pudo verificar la caché.'
    [[ -z $changes ]] || die "Hay diferencias entre $src y $dst. Se conserva el original."
}

migrate_directory() (
    local relative=$1 src="$home/$1" dst="$sgo/$1"
    local parent=${src%/*} leaf=${src##*/} recovery_prefix=.fclean-original.
    local staging backup link target resolved special merged=false
    if [[ $relative == .cache ]]; then recovery_prefix=.fclean-cache-original.; fi
    if [[ ! -L $parent ]]; then
        for backup in "$parent/$recovery_prefix"*; do
            die "Hay una migración anterior pendiente de revisar en $backup"
        done
    fi
    if [[ -L $parent || -L $src ]]; then
        link=$src
        target=$dst
        if [[ -L $parent ]]; then link=$parent; target="$sgo/.vscode"; fi
        trusted_destination "$target" || die "Destino no válido para $link: $target"
        if [[ $(realpath -m -- "$link") != "$(realpath -m -- "$target")" ]]; then
            notice "Se omite $link porque ya apunta a otro destino: $(readlink -- "$link")"
            [[ $mode == --dry-run ]] || exit 1
            return 0
        fi
        if [[ $mode != --dry-run && ! -d $link ]]; then die "Enlace sin destino válido: $link"; fi
        printf 'Se conserva el enlace existente: %s -> %s\n' "$link" "$(readlink -- "$link")"
        return 0
    fi
    if [[ $parent != "$home" ]] && present "$parent"; then
        plain_directory "$home" "$parent" || die "Directorio enlazado o montado: $parent"
    fi
    trusted_destination "$dst" || die "Revisa el propietario, permisos y enlaces de $dst"
    if [[ -d $dst ]]; then
        local base
        base=$(realpath -e -- "$sgo")
        plain_directory "$base" "$base/$relative" || die "Destino enlazado o con montajes: $dst"
    fi
    if present "$src"; then
        plain_directory "$home" "$src" || die "Origen inesperado: $src"
    fi
    if [[ -d $src ]]; then
        if [[ $relative == .cache ]]; then
            special=$(find -P "$src" ! -type d ! -type f ! -type l -print -quit)
            if [[ -n $special ]]; then
                if [[ $mode == --dry-run ]]; then
                    notice "Se omite la migración de caché mientras exista este archivo especial: $special"
                    return 0
                fi
                die "Revisa el archivo especial antes de migrar la caché: $special"
            fi
        fi
        # Las extensiones de desarrollo a veces apuntan a un proyecto vecino.
        # Un enlace relativo que sale del árbol cambiaría al moverlo.
        find -P "$src" -type l -printf '%p\0%l\0' |
            while IFS= read -r -d '' link && IFS= read -r -d '' target; do
                [[ $target != /* ]] || continue
                resolved=$(realpath -ms -- "${link%/*}/$target")
                [[ $resolved == "$src" || $resolved == "$src/"* ]] ||
                    die "El enlace relativo $link apunta fuera de $src. Revisa su destino antes de migrar."
            done
    fi
    if [[ $relative == .vscode/extensions && -d $src && -d $dst ]]; then
        diff -qr --no-dereference -- "$src" "$dst" ||
            die "Ya hay extensiones distintas en $dst. Se conservan ambas carpetas."
    fi
    if [[ $mode != --dry-run ]]; then ensure_sgo_directories "${dst%/*}"; fi
    if [[ $relative == .cache && -d $src && -d $dst ]]; then
        command -v rsync >/dev/null || die "Se necesita rsync para combinar las cachés de $src y $dst."
        check_cache_copy "$src" "$dst" --existing
        if [[ $mode != --dry-run ]]; then
            rsync -aHAX --ignore-existing --chmod=Du+rwx,Dgo-rwx -- "$src/" "$dst/"
            check_cache_copy "$src" "$dst"
            merged=true
        fi
    fi
    if [[ $mode == --dry-run ]]; then
        printf 'Migración opcional: %s -> %s\n' "$src" "$dst"
        if [[ -d $src ]]; then
            local size kib
            size=$(du -skx -- "$src")
            kib=${size%%$'\t'*}
            printf '%s\t%s\n' "$(format_size "$kib")" "$src"
            printf '%s\n' "$kib" >&"$migration_report_fd"
        fi
        return 0
    fi
    mkdir -p -- "$parent"
    if [[ ! -d $dst ]]; then
        staging=$(mktemp -d -- "${dst%/*}/.fclean-copia.XXXXXXXX")
        trap 'rm -rf --one-file-system -- "$staging"' EXIT
        mkdir -- "$staging/data"
        if [[ -d $src ]]; then
            cp -a -- "$src/." "$staging/data/"
            diff -qr --no-dereference -- "$src" "$staging/data" || die 'La copia no coincide con el original.'
            chmod 700 -- "$staging/data"
        fi
        mv -nT -- "$staging/data" "$dst"
        [[ ! -d $staging/data ]] || die "Otro proceso creó $dst durante la copia."
        rmdir -- "$staging"
        trap - EXIT
    fi
    if [[ -d $src ]]; then
        backup=$(mktemp -d -- "$parent/${recovery_prefix}XXXXXXXX")
        printf 'Original de recuperación durante la migración: %s/%s\n' "$backup" "$leaf"
        # Si la verificación final o la creación del enlace falla, restaura
        # el nombre original siempre que otra sesión no lo haya ocupado.
        trap 'if present "$backup/$leaf" && ! present "$src"; then mv -nT -- "$backup/$leaf" "$src"; fi
              if ! present "$backup/$leaf"; then rmdir -- "$backup"; fi' EXIT
        mv -T -- "$src" "$backup/$leaf"
        if $merged; then
            check_cache_copy "$backup/$leaf" "$dst"
        else
            diff -qr --no-dereference -- "$backup/$leaf" "$dst" ||
                die "El original cambió durante la migración. Se conserva la copia de sgoinfre en $dst"
        fi
        ln -sT -- "$dst" "$src"
        trap - EXIT
        rm -rf --one-file-system -- "$backup"
    else
        ln -sT -- "$dst" "$src"
    fi
    printf 'Directorio migrado y enlazado: %s -> %s\n' "$src" "$dst"
)

preview_migration() {
    local output_fd report_fd report_pid kib
    # Cada comprobación conserva errexit aunque su fallo no detenga la vista previa.
    # El tamaño viaja separado de los mensajes y de los nombres de archivo.
    exec {output_fd}>&1
    exec {report_fd}< <(
        exec {migration_report_fd}>&1
        migrate_directory "$1" >&"$output_fd"
    )
    report_pid=$!
    exec {output_fd}>&-
    while IFS= read -r kib; do
        total_migration_kib=$((total_migration_kib + kib))
    done <&"$report_fd"
    exec {report_fd}<&-
    wait "$report_pid" || notice "Se omite la migración opcional de $1."
}

code_processes='code|code-oss|code-insiders|codium'
cache_migration_ready() {
    [[ ! -d $home/.cache || -L $home/.cache ]] ||
        app_closed "$code_processes|chrome|chromium|brave|firefox|firefox-bin|slack|discord|spotify|uv|bun|npm" \
            'una aplicación que usa la caché'
}

case $mode in
    --funinstall)
        uninstall_files check
        if present "$desktop"; then
            [[ -f $desktop && ! -L $desktop ]] && grep -Fxq -- "$marker" "$desktop" ||
                die "La entrada $desktop no pertenece a fclean."
        fi
        update_zshrc funinstall "$zshrc"
        if [[ $zshrc != "$HOME/.zshrc" ]]; then update_zshrc funinstall "$HOME/.zshrc"; fi
        if present "$desktop"; then rm -- "$desktop"; fi
        inspect_home_venvs || die 'Quedan archivos de seguimiento por revisar. Se conserva la instalación para poder reintentarlo.'
        if [[ -d $sgo ]] && sgo_available && trusted_destination "$sgo"; then
            inspect_home_venvs "$(realpath -e -- "$sgo")" ||
                die 'Quedan archivos de seguimiento por revisar en sgoinfre. Se conserva la instalación para poder reintentarlo.'
        fi
        uninstall_files remove
        if [[ ! -L $lock && -O $lock && /proc/self/fd/9 -ef $lock ]]; then rm -- "$lock"; fi
        printf 'Instalación de fclean eliminada, incluido el script.\n'
        exit 0 ;;
    --prepare-env)
        ensure_sgo_directories "$sgo/.cache/uv" "$sgo/.cache/huggingface" "$sgo/.local/share"
        exit 0 ;;
    --migrate-cache)
        sgo_available || die "No se pudo verificar el almacenamiento de $sgo"
        cache_migration_ready || exit 1
        repair_link "$home/.cache" "$sgo/.cache"
        migrate_directory .cache
        exit 0 ;;
esac
declare -A managed_dirs=()
sgo_root=''
sgo_identity=''
if [[ $mode != --migrate && -d $sgo ]] && sgo_available; then
    sgo_root=$(realpath -e -- "$sgo")
    sgo_identity=$(stat -Lc '%d:%i' -- "$sgo_root")
    register_migrated_link .cache .cache
    register_migrated_link .local/share .local/share
    register_migrated_link .config/Code/Cache vscode_config/Cache
    register_migrated_link .config/Code/CachedData vscode_config/CachedData
    register_migrated_link .config/Code/CachedExtensionVSIXs vscode_config/CachedExtensionVSIXs
    if [[ -L $home/.vscode ]]; then register_migrated_link .vscode .vscode
    else register_migrated_link .vscode/extensions .vscode/extensions
    fi
fi
if has_legacy_block "$zshrc"; then
    notice 'El bloque antiguo sigue activo. Usa --install para retirarlo con copia de seguridad.'
fi
format_size() {
    local kib=$1
    if (( kib == 0 )); then
        printf '0 B'
        return
    fi
    if (( kib < 1024 )); then
        printf '%d KiB' "$kib"
        return
    fi
    if (( kib < 1048576 )); then
        local mib=$(( kib / 1024 ))
        local rem=$(( (kib % 1024) * 100 / 1024 ))
        if (( rem == 0 )); then
            printf '%d MiB' "$mib"
        elif (( rem % 10 == 0 )); then
            printf '%d.%d MiB' "$mib" "$(( rem / 10 ))"
        else
            printf '%d.%02d MiB' "$mib" "$rem"
        fi
        return
    fi
    if (( kib < 1073741824 )); then
        local gib=$(( kib / 1048576 ))
        local rem=$(( (kib % 1048576) * 100 / 1048576 ))
        if (( rem == 0 )); then
            printf '%d GiB' "$gib"
        elif (( rem % 10 == 0 )); then
            printf '%d.%d GiB' "$gib" "$(( rem / 10 ))"
        else
            printf '%d.%02d GiB' "$gib" "$rem"
        fi
        return
    fi
    local tib=$(( kib / 1073741824 ))
    local rem=$(( (kib % 1073741824) * 100 / 1073741824 ))
    if (( rem == 0 )); then
        printf '%d TiB' "$tib"
    elif (( rem % 10 == 0 )); then
        printf '%d.%d TiB' "$tib" "$(( rem / 10 ))"
    else
        printf '%d.%02d TiB' "$tib" "$rem"
    fi
}

print_clean_summary() {
    local kib=${1:-0}
    printf '\nResumen de limpieza:\n'
    printf '  Total borrado: %s\n' "$(format_size "$kib")"
    ( df -hP "$home" 2>/dev/null || true ) | awk '
        NR == 2 {
            count++
            printf "  Espacio restante en home: %s disponible (total: %s, en uso: %s)\n", $4, $2, $5
        }
        END {
            if (!count) print "  Espacio restante en home: no se pudo determinar"
        }
    '
}

print_dry_run_summary() {
    printf '\nResumen estimado (--dry-run):\n'
    printf '  Total por limpieza (home y sgoinfre): %s\n' "$(format_size "$total_cleaned_kib")"
    printf '  Total por migración opcional (espacio liberado en home): %s\n' "$(format_size "$total_migration_kib")"
    printf '  Estimaciones independientes: no se suman, pueden incluir el mismo contenido.\n'
}

total_cleaned_kib=0
total_migration_kib=0
if [[ $mode != --migrate ]]; then
    if [[ $mode == --dry-run ]]; then
        printf 'Contenido que se eliminaría:\n'
    else
        printf 'Contenido eliminado:\n'
    fi
    any_cleaned=false
    exec {report_fd}< <(clean_app_caches; inspect_home_venvs)
    report_pid=$!
    while IFS=$'\t' read -r size_spec rest || [[ -n $size_spec ]]; do
        [[ -n $size_spec ]] || continue
        any_cleaned=true
        if [[ $size_spec =~ ^([0-9]+)$ ]]; then
            kib=${BASH_REMATCH[1]}
            total_cleaned_kib=$((total_cleaned_kib + kib))
            formatted=$(format_size "$kib")
        elif [[ $size_spec =~ ^([0-9]+)[[:space:]]*KiB$ ]]; then
            kib=${BASH_REMATCH[1]}
            total_cleaned_kib=$((total_cleaned_kib + kib))
            formatted=$(format_size "$kib")
        else
            formatted=$size_spec
        fi
        if [[ -n $rest ]]; then
            printf '%s\t%s\n' "$formatted" "$rest"
        else
            printf '%s\n' "$formatted"
        fi
    done <&"$report_fd"
    exec {report_fd}<&-
    wait "$report_pid" || die 'No se pudo completar el recorrido de limpieza.'
    if ! $any_cleaned; then
        printf 'No se encontró contenido que limpiar.\n'
    fi
fi
if ! sgo_available; then
    notice "No se pudo verificar $sgo como almacenamiento separado y escribible."
    [[ $mode != --migrate ]] || exit 1
else
    if [[ $mode == --migrate ]]; then
        app_closed "$code_processes" 'la migración de extensiones de VS Code' || exit 1
    else
        repair_disposable_links
    fi
    repair_link "$home/.vscode" "$sgo/.vscode"
    repair_link "$home/.vscode/extensions" "$sgo/.vscode/extensions"
    case $mode in
        --migrate) migrate_directory .vscode/extensions ;;
        --dry-run)
            if app_closed "$code_processes" 'la migración de extensiones de VS Code'; then
                preview_migration .vscode/extensions
            fi
            if cache_migration_ready; then
                preview_migration .cache
            fi ;;
    esac
fi
if [[ $mode == --clean || $mode == --fclean ]]; then
    print_clean_summary "$total_cleaned_kib"
elif [[ $mode == --dry-run ]]; then
    print_dry_run_summary
fi
